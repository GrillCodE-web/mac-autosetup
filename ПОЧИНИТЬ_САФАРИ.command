#!/bin/bash

# ============================================================
#  ПОЧИНКА SAFARI — разовая. Лечит поломку от версии v8
#  скрипта ЗАПУСТИТЬ.command: та уводила контейнер Safari
#  (~/Library/Containers/com.apple.Safari — там cookies,
#  логины, настройки, кэш) на секретный диск симлинком.
#  Safari — системное sandbox-приложение, его песочница не
#  пускает на /Volumes, поэтому Safari ПЕРЕСТАВАЛ ОТКРЫВАТЬСЯ.
#
#  Что делает этот скрипт:
#   1) закрывает Safari;
#   2) находит копию контейнера на секретном диске
#      (.../Safari_Container/com.apple.Safari);
#   3) снимает симлинк и возвращает контейнер в систему
#      ВМЕСТЕ с cookies и логинами;
#   4) если симлинк уже снимали вручную (контейнера в системе
#      нет) — тоже возвращает контейнер с диска;
#   5) если контейнер в системе уже настоящий, а на диске
#      осталась копия — спросит, что важнее, и наведёт порядок;
#   6) если чинить нечего — честно скажет это и уйдёт.
#
#  Профиль Safari (~/Library/Safari: закладки, история) —
#  на секретном диске как и раньше, этот скрипт его НЕ трогает.
# ============================================================

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
cd "$HOME" || exit 1

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'
ok()   { echo -e "  ${GREEN}OK${NC}  $1"; }
bad()  { echo -e "  ${RED}!!${NC}  $1"; }
ask()  { echo -e "  ${YELLOW}?${NC}   $1"; }
dim()  { echo -e "  ${GREY}· $1${NC}"; }
step() { echo ""; echo -e "${BOLD}== $1 ==${NC}"; }

SFC="$HOME/Library/Containers/com.apple.Safari"
DISK_COPY=""
DISK_ROOT=""

echo -e "${BOLD}Починка Safari: контейнер и cookies. Профиль (закладки, история) на диске не трогаю.${NC}"

# ---------- 1. Закрыть Safari ----------
step "1/4 Закрываю Safari (иначе он держит файлы контейнера)"
osascript -e 'quit app "Safari"' 2>/dev/null
sleep 3
if pgrep -x Safari >/dev/null 2>&1; then
    bad "Safari всё ещё запущен — закрой его руками и запусти этот скрипт ещё раз"
    exit 1
fi
ok "Safari закрыт"

# ---------- 2. Найти копию контейнера на секретном диске ----------
step "2/4 Ищу копию контейнера на секретном диске"
# v8 клала копию в <корень данных>/Safari_Container/com.apple.Safari.
# Корень данных на любом томе /Volumes, глубина запаса — 6.
ALL_COPIES=$(find /Volumes -maxdepth 6 -type d -path "*Safari_Container/com.apple.Safari" \
             -not -path "*/.Trashes/*" -not -path "*/.Spotlight-V100/*" 2>/dev/null)
DISK_COPY=$(echo "$ALL_COPIES" | head -1)
if [ -n "$DISK_COPY" ]; then
    DISK_ROOT=$(dirname "$DISK_COPY")          # .../Safari_Container
    ok "копия найдена: $DISK_COPY"
    N=$(echo "$ALL_COPIES" | grep -c .)
    [ "$N" -gt 1 ] && dim "копий больше одной — беру первую, остальные проверь сам: $(echo "$ALL_COPIES" | tr '\n' ' ')"
else
    dim "копии контейнера на дисках не видно"
    OTHER=$(ls /Volumes 2>/dev/null | tr '\n' ' ')
    dim "сейчас подключены тома: ${OTHER:-нет}"
fi

# ---------- 3. Починка ----------
step "3/4 Чиню контейнер"

if [ -L "$SFC" ]; then
    # Поломка v8: симлинк вместо контейнера.
    if [ -n "$DISK_COPY" ]; then
        rm -f "$SFC"
        if cp -Rp "$DISK_COPY" "$SFC" 2>/dev/null && [ -n "$(ls -A "$SFC" 2>/dev/null)" ]; then
            rm -rf "$DISK_ROOT"
            ok "симлинк снят, контейнер с cookies и логинами вернулся в систему"
            ok "копия с диска удалена (данные теперь только в системе)"
        else
            rm -rf "$SFC"
            bad "контейнер не скопировался с диска (вероятно, Терминалу не хватает «Полного доступа к диску»)"
            dim "дай Терминалу «Полный доступ к диску» (Настройки -> Конфиденциальность и безопасность), перезапусти Терминал и запусти этот скрипт снова"
            dim "копия на диске НЕ тронута: $DISK_COPY"
        fi
    else
        rm -f "$SFC"
        ok "симлинк снят (копии на диске не нашлось)"
        dim "Safari создаст контейнер заново; cookies из эпохи v8, увы, не сохранились"
    fi
elif [ ! -e "$SFC" ] && [ -n "$DISK_COPY" ]; then
    # Симлинк сняли вручную (rm), а контейнер не вернули — cookies остались на диске.
    ask "Контейнера в системе нет, на диске лежит его копия с cookies — возвращаю."
    if cp -Rp "$DISK_COPY" "$SFC" 2>/dev/null && [ -n "$(ls -A "$SFC" 2>/dev/null)" ]; then
        rm -rf "$DISK_ROOT"
        ok "контейнер с cookies и логинами вернулся в систему, копия с диска удалена"
    else
        rm -rf "$SFC"
        bad "не скопировалось (вероятно, нужен «Полный доступ к диску» для Терминала) — копия на диске НЕ тронута: $DISK_COPY"
    fi
elif [ -d "$SFC" ] && [ -n "$DISK_COPY" ]; then
    # Контейнер уже настоящий (или свежий-пустой), на диске осталась копия v8.
    # Локальный НЕ перезаписываю молча: в нём могут быть данные НОВЕЕ.
    ask "Контейнер в системе на месте, но на диске осталась копия (эпоха v8): $DISK_COPY"
    ask "Логины и куки в Safari УЖЕ на месте? [д/Н]"
    read -r ANS
    case "$ANS" in
        д|Д|y|Y)
            rm -rf "$DISK_ROOT"
            ok "копия на диске удалена (локальный контейнер не тронут)"
            ;;
        *)
            ask "Тогда копия с диска СТАРЕЕ? Возвращать её поверх локального НЕ буду — это сотрёт свежее."
            ask "Заменить локальный контейнер копией с диска? Локальный будет стёрт. [д/Н]"
            read -r ANS2
            case "$ANS2" in
                д|Д|y|Y)
                    rm -rf "$SFC"
                    if cp -Rp "$DISK_COPY" "$SFC" 2>/dev/null && [ -n "$(ls -A "$SFC" 2>/dev/null)" ]; then
                        rm -rf "$DISK_ROOT"
                        ok "контейнер заменён копией с диска (cookies эпохи v8 вернулись)"
                    else
                        rm -rf "$SFC"
                        bad "не скопировалось: дай Терминалу «Полный доступ к диску» и запусти снова. Локальный контейнер удалён, копия на диске на месте: $DISK_COPY"
                    fi
                    ;;
                *)
                    dim "ничего не делаю: локальный контейнер на месте, копия осталась на диске ($DISK_ROOT)"
                    dim "решишь стереть позже: rm -rf \"$DISK_ROOT\""
                    ;;
            esac
            ;;
    esac
elif [ -d "$SFC" ]; then
    ok "нечего чинить: контейнер в системе, копии на диске нет (это нормальное состояние)"
else
    ok "контейнера нет ни в системе, ни на диске — Safari создаст его сам при первом запуске"
fi

# ---------- 4. Итог ----------
step "4/4 Итог"
if [ -L "$SFC" ]; then
    bad "контейнер ВСЁ ЕЩЁ симлинк — Safari не откроется. Скопируй итог в чат:"
    readlink "$SFC"
else
    ok "контейнер ~/Library/Containers/com.apple.Safari — обычная папка в системе"
    echo ""
    echo -e "${BOLD}Готово. Открой Safari и проверь, что:${NC}"
    echo "  1) он запускается;"
    echo "  2) логины и куки на месте (зайди на пару сайтов, где был залогинен)."
    echo "Профиль (закладки, история) — на секретном диске, как и раньше."
fi
echo ""
echo "Напоминание: cookies и настройки Safari macOS держит только в системе —"
echo "на внешний диск их вынести нельзя. Для чувствительного Safari не используй."
echo "Если есть строки с '!!' — скопируй весь итог в чат."
